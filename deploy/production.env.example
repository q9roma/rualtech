# Template only. Set secrets on the server; never commit a filled copy.
APP_NAME="Руалтек"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://rualtech.ru
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rualtech
DB_USERNAME=rualtech_app
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=660
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=office@rualtech.ru
MAIL_FROM_NAME="Руалтек"
TRUSTED_PROXIES=
DEPLOY_SECRETS_ROTATED=false
STOREFRONT_INERTIA=true
LUNAR_PROTOTYPE_ENABLED=false
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
CATALOG_PYTHON=/srv/altech/catalog-python/bin/python
VITE_APP_NAME="${APP_NAME}"
